# ---------------------------------------------------------------------------
# Copy this file to ".env" in the same folder, then fill in the real values.
# Never commit the real ".env" file — only this .example file should be in git.
# ---------------------------------------------------------------------------

# --- Supabase (database + file storage) ---------------------------------
# 1. Go to https://supabase.com and create a project (or open your existing one).
# 2. In the dashboard: Project Settings -> Database -> Connection string ->
#    copy the "URI" one (it looks like postgresql://postgres:[PASSWORD]@...).
#    Paste it below as DATABASE_URL. Replace [PASSWORD] with your actual
#    database password (set when you created the project).
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@YOUR_PROJECT_REF.supabase.co:5432/postgres

# 3. In the dashboard: Project Settings -> API -> "Project URL"
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# 4. Same page: Project Settings -> API -> "service_role" key (NOT the "anon"
#    key — service_role bypasses row-level security and is what the server
#    uses to upload files on your behalf. Keep this one secret, it never goes
#    into any frontend code).
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY

# 5. In the dashboard: Storage -> create a new bucket, name it exactly
#    "blooom-media" and mark it Public (so uploaded photos have plain URLs).
SUPABASE_STORAGE_BUCKET=blooom-media

# --- Auth secrets ----------------------------------------------------------
# JWT_SECRET: any long random string, used to sign login sessions. Generate
# one yourself, e.g. run this in a terminal:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# GOD_PASSWORD: the one-time "developer master password" you type in to log
# in as god-mode. Set it to whatever you want here in plain text — the
# server hashes it in memory on startup, it is never stored in the database.
# Change this value any time you want to rotate the god password.
GOD_PASSWORD=choose_a_strong_password_here

# --- CORS -------------------------------------------------------------------
# The two frontend URLs allowed to call this API. Comma-separated, no spaces.
# While developing locally these are your Vite dev server addresses; once
# deployed, swap them for your real domains (e.g. https://blooom.online and
# https://admin.blooom.online).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Server -----------------------------------------------------------------
PORT=4000
